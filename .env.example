# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser, gated by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER SIDE ONLY. Never expose to the browser.
# Used by privileged server actions if needed (kept out of client bundles).
SUPABASE_SERVICE_ROLE_KEY=

# Name of the public Storage bucket used for admin-uploaded images.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Payment instructions fallback
# ---------------------------------------------------------------------------
# These are used only when the `settings` row in the database is empty.
# The admin panel is the source of truth once configured.
NEXT_PUBLIC_PAYMENT_IBAN=
NEXT_PUBLIC_PAYMENT_ACCOUNT_HOLDER=Kambiz Akhbari
NEXT_PUBLIC_PAYMENT_CURRENCY=TRY

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical site URL, used for SEO metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=https://kambizakhbari.com

# ---------------------------------------------------------------------------
# Optional: hero and biography portraits by URL (no file commit needed)
# ---------------------------------------------------------------------------
# Set these to a hosted image URL to fill the hero and bio portraits without
# committing files. A Supabase Storage public URL works out of the box, since
# *.supabase.co is already allowed for next/image. Leave empty to use the local
# files at public/images/hero-portrait.jpg and public/images/about-portrait.jpg.
NEXT_PUBLIC_HERO_PORTRAIT=
NEXT_PUBLIC_ABOUT_PORTRAIT=
